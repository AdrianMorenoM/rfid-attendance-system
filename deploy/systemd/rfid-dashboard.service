[Unit]
Description=RFID Dashboard Service
After=network.target

[Service]
Type=simple
User=rfid-svc
WorkingDirectory=/home/admin/rfid-system/dashboard

# Reducir workers de 4 a 2, agregar threads
Nice=5
ExecStart=/home/admin/rfid-system/venv/bin/gunicorn -w 2 --threads 2 -b 127.0.0.1:5000 app_dashboard:app

Restart=always
RestartSec=5

# Evitar matar procesos relacionados (protege SSH)
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
