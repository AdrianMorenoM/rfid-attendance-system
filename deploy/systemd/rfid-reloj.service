[Unit]
Description=Corrige las horas de lecturas tomadas con el reloj sin sincronizar
After=rfid-reader.service

[Service]
Type=oneshot
User=rfid-svc
WorkingDirectory=/home/admin/rfid-system/common
ExecStart=/home/admin/rfid-system/venv/bin/python3 /home/admin/rfid-system/common/rfid_reloj.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/rfid-system/data
